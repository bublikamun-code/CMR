# Доступ к FTP — не в репозиторий
.ftpenv

*.pyc
__pycache__/
.DS_Store

# --- Секреты и данные ---
# .secret_key подписывает JWT: попадание в историю git = возможность
# подделать токен любого пользователя. Утёкший ключ нельзя «разкоммитить»,
# только менять на сервере, поэтому блокируем заранее.
.secret_key
.cron_token
*.env
.env*
# ...but the template carries no secrets and must be in the repo.
!.env.example

# email_settings.json содержит IMAP-пароль почтового ящика.
# На сервере создаётся/обновляется через UI настроек или вручную.
# Шаблон лежит в репозитории как email_settings.example.json.
email_settings.json

# Базы с реальными данными клиентов и заказов. Плюс SQLite WAL/SHM —
# бинарные, конфликтуют при каждом слиянии, смысла в версионировании нет.
*.db
*.db-shm
*.db-wal
*.db.backup_*
*.sqlite
*.sqlite3

# Загруженные счета и накладные клиентов (на сервере ~220 МБ).
uploads/

# Ручные бэкапы, накопленные на сервере: 35 копий style.css и подобное.
# Историю ведёт git, дубли только мешают.
*.bak
*.bak_*
*.bak-*

# --- Бэкапы, сертификаты, восстановленные данные ---
# Содержат данные клиентов и приватные ключи: в репозиторий не должны попадать
# ни при каких условиях.
backups/
ssl/
letsencrypt/
certbot-webroot/
recovery/

# Служебное: сканер безопасности, планы сессий агента, тест-скриншоты
.mimosa/
.zcode/
gui-test-screenshots/
# Локальный оверрайд портов (8000 занят другим проектом на этой машине)
docker-compose.override.yml
