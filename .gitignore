# Доступ к FTP — не в репозиторий
.ftpenv

*.pyc
__pycache__/
.DS_Store

# --- Секреты и данные ---
# .secret_key подписывает JWT: попадание в историю git = возможность
# подделать токен любого пользователя. Утёкший ключ нельзя «разкоммитить»,
# только менять на сервере, поэтому блокируем заранее.
.secret_key
*.env
.env*

# Базы с реальными данными клиентов и заказов. Плюс SQLite WAL/SHM —
# бинарные, конфликтуют при каждом слиянии, смысла в версионировании нет.
*.db
*.db-shm
*.db-wal
*.db.backup_*
*.sqlite
*.sqlite3

# Загруженные счета и накладные клиентов (на сервере ~220 МБ).
uploads/

# Ручные бэкапы, накопленные на сервере: 35 копий style.css и подобное.
# Историю ведёт git, дубли только мешают.
*.bak
*.bak_*
*.bak-*
