#!/bin/bash
# pre-push: гейт Фазы 4 — не даёт запушить код, не проходящий scripts/check.sh.
# Actions на GitHub не подтверждена (API-токен не видит репозиторий), поэтому
# блокирующим механизмом на этой машине является этот хук: все деплои идут
# с неё, а push красного кода в main/refactor/* теперь физически невозможен.
# Установка на другой машине: cp scripts/check.sh .git/hooks/... — лучше
# скопировать этот файл (он не версионируется, это локальный .git).
#
# Мастер-копия лежит в scripts/pre-push.sample (версионируется).
set -e
exec bash scripts/check.sh
