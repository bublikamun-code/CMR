# Copy to .env.local (development) or .env.production (server) and fill in.
# IMPORTANT: variable names must match what the code reads - see auth.py / database.py.

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Режим конфигурации: development/test допускают локальный HTTP-default,
# production требует явной cookie policy на запуске.
CRM_DEPLOYMENT=development

# Единая политика Secure для login и скользящего продления cookie.
# Для локального HTTP: false. Для production: только true; отсутствующее или
# невалидное значение завершает startup с понятной ошибкой.
CRM_COOKIE_SECURE=false

# Прямые прокси, которым разрешено задавать X-Forwarded-* (строгие CIDR).
# Docker Compose переопределяет это значение для своей подсети. Пустое значение
# не включает доверие forwarded-адресам, невалидный CIDR останавливает startup.
# CRM_TRUSTED_PROXY_NETWORKS=127.0.0.1/32

# CORS allowed origins (comma-separated)
# Local development:
CRM_CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
# Production example:
# CRM_CORS_ORIGINS=https://crm-svetvdome.online,https://www.crm-svetvdome.online

# JWT signing key. Read by auth.py as CRM_SECRET_KEY (NOT "SECRET_KEY").
# If unset, the app falls back to a file on disk and this value is ignored.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CRM_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# Token for unattended cron endpoints, sent as the X-Cron-Token header.
# Read by auth.py as CRM_CRON_TOKEN.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CRM_CRON_TOKEN=CHANGE_ME_GENERATE_A_REAL_TOKEN

# Dedicated Fernet key for mailbox passwords. It is intentionally separate from
# CRM_SECRET_KEY (JWT) and never falls back to it. Accepts 64 hex characters or
# a 44-character URL-safe base64 Fernet key. Outside production, if omitted,
# the app creates $CRM_DATA_DIR/.email_secret_key; production never generates it.
# CRM_EMAIL_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_EMAIL_KEY

# Optional operator override, used only when no password exists in settings.
# It never overrides or rescues an invalid stored ciphertext or Fernet key.
# CRM_SMTP_PASSWORD=

# Directory for SQLite databases and secret files.
# In Docker this is a persistent volume; leave unset on bare metal to keep the
# legacy layout (databases next to the code).
CRM_DATA_DIR=/app/data

# Каталог загрузок (иначе CRM_DATA_DIR/uploads, иначе uploads рядом с кодом)
# CRM_UPLOADS_DIR=/app/uploads

# Readiness по умолчанию требует все миграции из server_snapshot/migrations.
# Явный список используется только для поэтапного обновления схемы; имена
# перечисляются через запятую. Проверяется только основная БД: миграции
# тенантных БД применяются отдельно и этим флагом не отмечаются.
# CRM_REQUIRED_MIGRATIONS=0001_add_card_position.py,...
