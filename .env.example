# Copy to .env.local (development) or .env.production (server) and fill in.
# IMPORTANT: variable names must match what the code reads - see auth.py / database.py.

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# CORS allowed origins (comma-separated)
# Local development:
CRM_CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
# Production example:
# CRM_CORS_ORIGINS=https://crm-svetvdome.online,https://www.crm-svetvdome.online

# JWT signing key. Read by auth.py as CRM_SECRET_KEY (NOT "SECRET_KEY").
# If unset, the app falls back to a file on disk and this value is ignored.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CRM_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# Token for unattended cron endpoints, sent as the X-Cron-Token header.
# Read by auth.py as CRM_CRON_TOKEN.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CRM_CRON_TOKEN=CHANGE_ME_GENERATE_A_REAL_TOKEN

# Directory for SQLite databases and secret files.
# In Docker this is a persistent volume; leave unset on bare metal to keep the
# legacy layout (databases next to the code).
CRM_DATA_DIR=/app/data

# Каталог загрузок (иначе CRM_DATA_DIR/uploads, иначе uploads рядом с кодом)
# CRM_UPLOADS_DIR=/app/uploads
